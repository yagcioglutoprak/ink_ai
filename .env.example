# Copy this to .env and fill in your keys

# ── LLM API (OpenAI-compatible) ───────────────────────
OPENAI_API_KEY=your_api_key_here

# API base URL (default: OpenAI)
OPENAI_BASE_URL=https://opencode.ai/zen/v1

# Model name (default: opencode/minimax-m2.5-free)
MODEL=opencode/minimax-m2.5-free

# Max response tokens (default: 8192)
MAX_TOKENS=8192

# Extended thinking (true/false, default: false)
ENABLE_THINKING=false
THINKING_BUDGET=10000

# Optional system prompt
# SYSTEM_PROMPT=You are a helpful AI assistant.

# ── MongoDB Atlas (optional) ─────────────────────────────
# If not set, the app runs without database persistence
MONGODB_URI=mongodb+srv://toprak:<db_password>@vapeshop.3nbkk.mongodb.net/?appName=vapeshop
MONGODB_DATABASE=ink_ai

# ── Exa Web Search (Phase 4) ────────────────────────────
EXA_API_KEY=your_exa_api_key_here

# ── Server ───────────────────────────────────────────────
PORT=3001
