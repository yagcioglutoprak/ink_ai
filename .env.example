# Copy this to .env and fill in your keys

# ── Anthropic API ────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Custom Anthropic-compatible API URL (optional)
# Set this to use a proxy or alternative endpoint
# Example: https://my-proxy.example.com
ANTHROPIC_BASE_URL=

# Model name (default: claude-sonnet-4-20250514)
MODEL=claude-sonnet-4-20250514

# Max response tokens (default: 8192)
MAX_TOKENS=8192

# Extended thinking (true/false, default: false)
ENABLE_THINKING=false
THINKING_BUDGET=10000

# Optional system prompt
# SYSTEM_PROMPT=You are a helpful AI assistant.

# ── Azure Cosmos DB (optional) ───────────────────────────
# If not set, the app runs without database persistence
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=ink_ai
AZURE_COSMOS_CONTAINER=conversations

# ── Exa Web Search (Phase 4) ────────────────────────────
EXA_API_KEY=your_exa_api_key_here

# ── Server ───────────────────────────────────────────────
PORT=3001
